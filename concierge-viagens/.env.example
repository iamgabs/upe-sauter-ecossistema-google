# Copie este arquivo para ".env" e preencha. O ".env" NUNCA deve ir para o Git.

# Chave gratuita do Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelo usado por todos os agentes (opcional)
MODEL=gemini-2.5-flash

# Servidor (opcional)
HOST=127.0.0.1
PORT=8000
